# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Template variabel lingkungan Docker
# Pertemuan 2: Containerization (Docker)
# Kelompok 1, Cloud Computing H7D.7
#
# Salin file ini ke .env.docker dan isi dengan nilai sebenarnya.
# File .env.docker TIDAK boleh di-commit (sudah di .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL Primary ────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GANTI_PASSWORD_PRIMARY
POSTGRES_DB=flashsale

# ── Replikasi ─────────────────────────────────────────────────────────────────
REPLICATION_USER=replicator
REPLICATION_PASSWORD=GANTI_PASSWORD_REPLICATOR

# ── Aplikasi Backend ──────────────────────────────────────────────────────────
PORT=3000
DB_HOST=db-primary
DB_PORT=5432
DB_NAME=flashsale
DB_USER=postgres
DB_PASSWORD=GANTI_PASSWORD_PRIMARY
DB_POOL_MAX=20

# Replica (hot standby)
DB_REPLICA_HOST=db-replica
DB_REPLICA_PORT=5432
