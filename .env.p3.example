# Run npm run p3:init to generate .env.p3 with local random credentials.
P3_ID=GENERATE_WITH_P3_INIT
P3_DB_PASSWORD=GENERATE_WITH_P3_INIT
P3_REPLICATION_PASSWORD=GENERATE_WITH_P3_INIT
P3_PORT=8080
P3_BACKEND_CPUS=0.5
P3_POOL_MAX=10
P3_MIN_REPLICAS=2
P3_MAX_REPLICAS=6
P3_INTERVAL_MS=5000
P3_SCALE_OUT_CPU=65
P3_SCALE_IN_CPU=25
P3_SCALE_OUT_WINDOW_MS=30000
P3_SCALE_IN_WINDOW_MS=180000
P3_SCALE_OUT_COOLDOWN_MS=60000
P3_SCALE_IN_COOLDOWN_MS=120000
P3_READY_TIMEOUT_MS=90000
P3_DRAIN_TIMEOUT_MS=90000
P3_COLLECT_BUDGET_MS=4000
P3_TERMINATION_TIMEOUT_MS=100000
# Empty = calculated conservative recovery budget; a shorter value is rejected.
P3_LIFECYCLE_LOW_SECONDS=
