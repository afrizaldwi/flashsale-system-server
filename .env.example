PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flashsale
DB_POOL_MAX=20

# Replica (read-only, streaming replication dari primary). Kosongkan jika tidak memakai replica.
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5433

# Failover database otomatis (aktif jika replica dikonfigurasi)
AUTO_FAILOVER=true
FAILOVER_THRESHOLD=3        # primary gagal berturut-turut sebelum replica dipromosikan
FAILOVER_CHECK_MS=1000      # interval pengecekan primary

# Load balancer (npm run start:cluster menjalankan 2 backend: 3001 dan 3002, LB di 3000)
LB_PORT=3000
BACKENDS=localhost:3001,localhost:3002
