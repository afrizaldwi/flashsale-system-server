# Pertemuan 1: satu backend Node.js di localhost. Nginx & Docker baru Pertemuan 2.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=flashsale
DB_USER=postgres
DB_PASSWORD=GANTI_PASSWORD_POSTGRES
DB_POOL_MAX=20

# Kosongkan DB_REPLICA_HOST jika belum mengonfigurasi streaming replica.
# Jika sudah, /products membaca replica pada port 5433.
DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_PORT=5433

# Failover selalu MANUAL. Tidak ada AUTO_FAILOVER maupun watchdog promosi otomatis.
# Jangan meletakkan konfigurasi/kredensial produksi dalam repository.
